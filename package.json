{
  "name": "amountfield",
  "version": "0.0.0",
  "description": "A money input for React that keeps amounts in exact minor units and knows that not every currency has two decimals.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "react": ">=18"
  },
  "scripts": {
    "test": "node --test test/*.test.ts",
    "demo": "node example/demo.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2"
  },
  "keywords": [
    "react",
    "money",
    "currency",
